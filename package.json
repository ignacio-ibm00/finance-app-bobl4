{
  "name": "finance-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IBM Bob Workshop - Finance Dashboard Application",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
